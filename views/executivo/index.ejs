<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
<title>Dashboard Executivo — SeuBoné</title>
<link rel="stylesheet" href="/css/hub-home.css">
<link rel="stylesheet" href="/css/indicadores-equipe.css">
<link rel="stylesheet" href="/css/executivo.css">
</head>
<body>
<div class="app-shell">
<%- include('../partials/sidebar') %>
<div class="app-main">

<div class="hh-wrap">

  <div class="hh-header">
    <div>
      <h1>Dashboard Executivo</h1>
      <p>Rascunho — visão consolidada da operação, sem filtro por consultor</p>
    </div>
  </div>

  <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px">
    <div class="hh-section-label" style="margin-bottom:0">KPIs da Equipe</div>
    <div class="ie-tabs">
      <button class="ie-tab active" data-periodo="semana" onclick="excSetPeriodo('semana', this)">Semana</button>
      <button class="ie-tab" data-periodo="mes" onclick="excSetPeriodo('mes', this)">Mês</button>
    </div>
  </div>

  <div class="hh-kpis-grid" style="margin-bottom:2rem">
    <div class="hh-kpi-card" id="exec-card-nps">
      <div class="hh-kpi-label">NPS</div>
      <div class="hh-kpi-value" id="exec-val-nps">--</div>
      <div class="hh-kpi-meta">Meta: <span>&gt; 80</span> · sem histórico disponível</div>
    </div>
    <div id="exec-kpis-chart" style="display:contents">
      <div class="ie-carregando"><i class="ti ti-loader-2" aria-hidden="true"></i> Carregando indicadores...</div>
    </div>
  </div>

  <div class="hh-section-label">Solicitações ao Financeiro</div>
  <div class="hh-kpis-grid" id="exec-financeiro">
    <div class="ie-carregando"><i class="ti ti-loader-2" aria-hidden="true"></i> Carregando...</div>
  </div>

  <div class="hh-section-label">Quitações Pendentes</div>
  <div class="hh-kpis-grid" id="exec-quitacoes">
    <div class="ie-carregando"><i class="ti ti-loader-2" aria-hidden="true"></i> Carregando...</div>
  </div>

  <div class="hh-section-label">Produção (Wallac)</div>
  <div class="hh-kpis-grid" id="exec-wallac">
    <div class="ie-carregando"><i class="ti ti-loader-2" aria-hidden="true"></i> Carregando...</div>
  </div>

  <div class="hh-section-label">Corridas Avulsas</div>
  <div class="hh-kpis-grid" id="exec-corridas">
    <div class="ie-carregando"><i class="ti ti-loader-2" aria-hidden="true"></i> Carregando...</div>
  </div>

</div>

</div>
</div>

<script src="/js/indicadores-equipe.js"></script>
<script src="/js/hub-home.js"></script>
<script src="/js/executivo.js"></script>
</body>
</html>
