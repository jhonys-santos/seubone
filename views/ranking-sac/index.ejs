<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
<title>Ranking SAC - SeuBoné</title>
<link rel="stylesheet" href="/css/ranking-sac.css">
</head>
<body>
<div class="app-shell">
<%- include('../partials/sidebar') %>
<div class="app-main">

<div class="rk-wrap">
  <div class="rk-header">
    <h1><i class="ti ti-trophy" aria-hidden="true"></i> Ranking SAC</h1>
    <p>Ranking por Score · Sexta → Quinta</p>
  </div>

  <div class="races-grid">
    <div class="race-panel">
      <div class="race-header">
        <div><div class="race-title">🏁 Corrida do Time Atendimento</div><div class="race-subtitle">Ranking por Score · Sexta → Quinta</div></div>
        <div class="race-badge">3 Consultores</div>
      </div>
      <div class="race-fixed"><div class="track-title">Ranking da Semana</div><div id="atd-track"></div></div>
      <div class="race-body"><div><div class="track-title">Indicadores por dia</div><div id="atd-tabela"></div></div></div>
    </div>
    <div class="race-panel">
      <div class="race-header">
        <div><div class="race-title">🔧 Corrida do Time Resolução</div><div class="race-subtitle">Ranking por Score · Sexta → Quinta</div></div>
        <div class="race-header-right">
          <div class="race-badge">2 Consultores</div>
          <div class="week-nav">
            <button type="button" id="rsl-week-prev" class="week-nav-btn" aria-label="Semana anterior">‹</button>
            <span id="rsl-week-label" class="week-nav-label">—</span>
            <button type="button" id="rsl-week-next" class="week-nav-btn" aria-label="Semana seguinte" disabled>›</button>
          </div>
        </div>
      </div>
      <div class="race-fixed"><div class="track-title">Ranking da Semana</div><div id="rsl-track"></div></div>
      <div class="race-body"><div><div class="track-title">Indicadores por dia</div><div id="rsl-tabela"></div></div></div>
    </div>
  </div>
</div>

</div>
</div>

<div class="refresh-indicator" id="refresh-ind">● carregando...</div>

<script src="/js/ranking-sac.js"></script>
</body>
</html>
