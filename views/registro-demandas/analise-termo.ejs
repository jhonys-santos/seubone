<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/head') %>
<title>Análise de Termo - SeuBoné</title>
<link rel="stylesheet" href="/css/pedidos-urgentes.css">
</head>
<body>
<div class="app-shell">
<%- include('../partials/sidebar') %>
<div class="app-main">

<div class="pu-scope">
<div class="pu-container">
  <div class="card">
    <% if (emTeste) { %>
    <div class="msg ok" style="display:block;margin:0 0 14px">Formulário em teste: só gestores veem esta página e os cards saem com <b>[TESTE]</b> nas observações.</div>
    <% } %>
    <% if (!integracaoConfigurada) { %>
    <div class="msg err" style="display:block;margin:0 0 14px">A integração com o finfin ainda não está configurada no servidor (falta o token). O envio não vai funcionar.</div>
    <% } %>

    <div style="font-size:13px;color:var(--text-muted);margin-bottom:14px">Solicitante: <b style="color:var(--text)"><%= nomeSolicitante %></b></div>

    <div class="row2">
      <div>
        <label>Seu e-mail *</label>
        <input type="email" id="t-email" placeholder="Inserir e-mail">
        <div style="font-size:11px;color:var(--text-muted);margin-top:3px">Quando o termo voltar (pré-aprovado, reprovado ou para ajustar), o retorno também chega por e-mail.</div>
      </div>
      <div>
        <label>CPF/CNPJ do cliente *</label>
        <input type="text" id="t-cpfcnpj" inputmode="numeric" placeholder="CPF ou CNPJ">
      </div>
    </div>

    <div class="row2">
      <div>
        <label>ID da venda *</label>
        <input type="text" id="t-idvenda" maxlength="60" placeholder="Inserir número">
      </div>
      <div>
        <label>Link do card no Lulu *</label>
        <input type="text" id="t-link" placeholder="https://lulu.seubone.com/...">
      </div>
    </div>

    <label>Forma de pagamento *</label>
    <textarea id="t-forma" rows="2" maxlength="300" placeholder="Ex.: 50% de entrada no PIX + 2 boletos de 30 e 60 dias"></textarea>

    <label>O pagamento será após a emissão da NF? *</label>
    <select id="t-apos-nf">
      <option value="">Selecionar opção...</option>
      <option value="sim">Sim</option>
      <option value="nao">Não</option>
    </select>

    <label>Observações</label>
    <textarea id="t-obs" rows="2" placeholder="Opcional"></textarea>

    <label>Orçamento (PDF) *</label>
    <input type="file" id="t-orcamento" accept="application/pdf,.pdf">
    <div class="anexos-lista" id="t-orcamento-lista"></div>

    <label>Layout do boné *</label>
    <input type="file" id="t-layout">
    <div class="anexos-lista" id="t-layout-lista"></div>
    <div style="font-size:12px;color:var(--text-muted);margin-top:6px;">Os dois arquivos são obrigatórios. 4 MB somados (limite do finfin).</div>

    <button class="btn-primary" id="btn-registrar"><i class="ti ti-send" aria-hidden="true"></i> Enviar para análise</button>
    <div class="msg" id="form-msg"></div>
  </div>

  <div class="card" style="margin-top:16px">
    <div style="font-weight:700;margin-bottom:8px">Meus últimos termos</div>
    <div id="minhas" style="font-size:13px;color:var(--text-muted)">Carregando...</div>
  </div>
</div>
</div>

</div>
</div>

<script src="/js/finfin-form-comum.js"></script>
<script src="/js/analise-termo.js"></script>
</body>
</html>
